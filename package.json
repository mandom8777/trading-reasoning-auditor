  "description": "Continuous, cost-aware audit of crypto trading signals via MiMo multi-agent reasoning.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts --mode once --fixture examples/sample_signal.json",
